# Normalize text files to LF in the repo (Windows-friendly with local core.eol)
* text=auto eol=lf

*.html text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.js text eol=lf
*.toml text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.mp3 binary
