<svg xmlns="http://www.w3.org/2000/svg" width="480" height="280" viewBox="0 0 480 280" role="img" aria-labelledby="title desc">
  <title id="title">Team photo placeholder</title>
  <desc id="desc">Faux image for Hugo page bundle demo</desc>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#1e3a5f"/>
      <stop offset="100%" stop-color="#336699"/>
    </linearGradient>
  </defs>
  <rect width="480" height="280" fill="url(#bg)" rx="12"/>
  <circle cx="240" cy="110" r="48" fill="#ffffff" opacity="0.9"/>
  <text x="240" y="200" text-anchor="middle" fill="#e8f0ff" font-family="system-ui,sans-serif" font-size="22" font-weight="600">Team placeholder</text>
  <text x="240" y="232" text-anchor="middle" fill="#b8cce8" font-family="system-ui,sans-serif" font-size="14">content/about/team/placeholder.svg</text>
</svg>
